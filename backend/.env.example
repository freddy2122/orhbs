DJANGO_SECRET_KEY=changez-moi-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Développement local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production Render : remplacer par l'URL Vercel (ex. https://orhsb.vercel.app)
# CORS_ALLOWED_ORIGINS=https://orhsb.vercel.app
# CSRF_TRUSTED_ORIGINS=https://orhsb.vercel.app
# DJANGO_ALLOWED_HOSTS=orhsb-api.onrender.com,.onrender.com
# DJANGO_DEBUG=False

# PostgreSQL local (Render fournit DATABASE_URL automatiquement)
POSTGRES_DB=orhsb
POSTGRES_USER=orhsb
POSTGRES_PASSWORD=orhsb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Emails — en local, la console Django affiche les messages (aucun SMTP requis).
# En production, renseigner un serveur SMTP réel (Render, OVH, Gmail App Password, etc.)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ORHS Bénin <noreply@orhsb.bj>
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
