{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://orhsb-api.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://orhsb-api.onrender.com/media/:path*"
    },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
